# Cloudflare Tunnel token
# Get this from: https://dash.cloudflare.com - Zero Trust - Networks - Tunnels - Create tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-token-here

# Postgres password for the fintrack database (choce your own strong value)
POSTGRES_PASSWORD=change-me

# Cloudflare Access team domain (the /access issuer). MUST include scheme.
# Example: https://blue-sunset-ee0f.cloudflareaccess.com
# If you later switch to a custom auth domain (e.g. auth.spidernet.men), update this to that URL.
CF_TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Cloudflare Access Application Audience (AUD) Tag
# Zero Trust > Access > Applications > your app > Application Audience (AUD) Tag
CF_AUD=your-aud-tag-here

# Optional: comma-separated list of allowed CORS origins (empty = same-origin only)
CORS_ORIGIN=
