# Cloudflare Tunnel token
# Get this from: https://dash.cloudflare.com - Zero Trust - Networks - Tunnels - Create tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-token-here

# Postgres password for the fintrack database (choose your own strong value)
POSTGRES_PASSWORD=change-me

# Optional: comma-separated list of allowed CORS origins (empty = same-origin only)
CORS_ORIGIN=

# --- FinTrack auth (email OTP + JWT) ---
# Secret used to sign access tokens (a long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Email allowed to log in as superadmin (everyone else is 'user' by default)
SUPERADMIN_EMAIL=gabrieltc555@gmail.com

# Set to 'false' only if you run the API over plain HTTP
COOKIE_SECURE=true

# How long an access token lives before the client refreshes it (minutes)
AUTH_ACCESS_TTL_MINUTES=15

# Absolute cap on a session since first sign-in, regardless of activity (days)
AUTH_ABSOLUTE_TTL_DAYS=30

# Keep refresh-token rows around for this many days before pruning (days)
AUTH_REFRESH_GC_DAYS=7

# --- SMTP (used to send the OTP login codes) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinTrack <no-reply@fintrack.app>