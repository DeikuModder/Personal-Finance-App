# FinTrack API environment
# Copy to .env and fill in real values.

# Postgres connection string (used inside docker-compose network)
DATABASE_URL=postgres://fintrack:fintrack@localhost:5432/fintrack

# Optional: strict CORS origin(s), comma-separated. Empty = allow same-origin.
CORS_ORIGIN=

# API listen port (default 3000)
PORT=3000

# JWT secret used to sign access tokens
AUTH_JWT_SECRET=

# Email allowed to log in as superadmin
SUPERADMIN_EMAIL=gabrieltc555@gmail.com

# Set to 'false' only if the API is served over plain HTTP
COOKIE_SECURE=true

# Access token lifetime before the client auto-refreshes (minutes)
AUTH_ACCESS_TTL_MINUTES=15

# Absolute session cap since first sign-in (days)
AUTH_ABSOLUTE_TTL_DAYS=30

# Prune revoked/expired refresh tokens older than this (days)
AUTH_REFRESH_GC_DAYS=7

# SMTP transport used to send OTP login codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FinTrack <no-reply@fintrack.app>