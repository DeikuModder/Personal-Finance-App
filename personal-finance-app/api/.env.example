# FinTrack API environment
# Copy to .env and fill in real values.

# Postgres connection string (used inside docker-compose network)
DATABASE_URL=postgres://fintrack:fintrack@localhost:5432/fintrack

# Cloudflare Access team domain (auth issuer)
# Example: https://blue-sunset-ee0f.cloudflareaccess.com
CF_TEAM_DOMAIN=

# Cloudflare Access Application Audience (AUD) tag
# Found in Zero Trust > Access > Applications > your app > Additional settings > Application Audience (AUD) Tag
CF_AUD=

# Optional: strict CORS origin(s), comma-separated. Empty = allow same-origin.
CORS_ORIGIN=

# API listen port (default 3000)
PORT=3000
